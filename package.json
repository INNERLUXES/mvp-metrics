{
  "name": "mvp-metrics",
  "version": "1.0.0",
  "description": "Measure an MVP against the success criteria written before launch: sign-ups, activation, retention by week and the share who paid, with a table by sign-up week. Says 'not enough data' instead of guessing. Reads files, fetches nothing, no dependencies.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "mvp-metrics": "bin/mvp-metrics.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\"",
    "check": "node tools/check.mjs",
    "example": "node bin/mvp-metrics.js --events examples/events.csv --criteria examples/criteria.json"
  },
  "keywords": [
    "mvp",
    "product-metrics",
    "activation",
    "retention",
    "cohort-analysis",
    "startup",
    "analytics",
    "cli"
  ],
  "author": "INNERLUXES <info@innerluxes.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INNERLUXES/mvp-metrics.git"
  },
  "homepage": "https://innerluxes.dev/software-development/mvp"
}
